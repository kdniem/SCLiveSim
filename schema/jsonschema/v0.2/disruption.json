{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kdniem/SCLiveSim/schema/v0.2.0/disruption.json",
  "x-schema-version": "0.2.0",
  "$defs": {
    "Affected": {
      "additionalProperties": false,
      "properties": {
        "locations": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Locations",
          "type": "array"
        },
        "lanes": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Lanes",
          "type": "array"
        }
      },
      "title": "Affected",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sim_run_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Sim Run Id",
      "type": "string"
    },
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "affected": {
      "$ref": "#/$defs/Affected"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    },
    "end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End"
    },
    "severity": {
      "maximum": 1,
      "minimum": 0,
      "title": "Severity",
      "type": "number"
    }
  },
  "required": [
    "sim_run_id",
    "id",
    "type",
    "affected",
    "start",
    "severity"
  ],
  "title": "Disruption",
  "type": "object"
}
