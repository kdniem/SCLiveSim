{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kdniem/SCLiveSim/schema/v0.1.0/lane.json",
  "x-schema-version": "0.1.0",
  "$defs": {
    "TransportMode": {
      "enum": [
        "road",
        "sea",
        "air",
        "rail"
      ],
      "title": "TransportMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "origin_location_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Origin Location Id",
      "type": "string"
    },
    "destination_location_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Destination Location Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/TransportMode"
    },
    "planned_transit_days": {
      "title": "Planned Transit Days",
      "type": "string"
    },
    "cost": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost"
    }
  },
  "required": [
    "id",
    "origin_location_id",
    "destination_location_id",
    "mode",
    "planned_transit_days"
  ],
  "title": "Lane",
  "type": "object"
}
