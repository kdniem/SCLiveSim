{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kdniem/SCLiveSim/schema/v0.1.0/location.json",
  "x-schema-version": "0.1.0",
  "$defs": {
    "LocationType": {
      "enum": [
        "plant",
        "warehouse",
        "port",
        "customer_site",
        "supplier_site"
      ],
      "title": "LocationType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/LocationType"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "country": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Country"
    },
    "lat": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lat"
    },
    "lon": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lon"
    },
    "attributes": {
      "additionalProperties": true,
      "title": "Attributes",
      "type": "object"
    }
  },
  "required": [
    "id",
    "type",
    "name"
  ],
  "title": "Location",
  "type": "object"
}
