{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kdniem/SCLiveSim/schema/v0.1.0/partner.json",
  "x-schema-version": "0.1.0",
  "$defs": {
    "PartnerRole": {
      "enum": [
        "supplier",
        "customer",
        "carrier"
      ],
      "title": "PartnerRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/PartnerRole"
    },
    "location_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location Id"
    },
    "attributes": {
      "additionalProperties": true,
      "title": "Attributes",
      "type": "object"
    }
  },
  "required": [
    "id",
    "role"
  ],
  "title": "Partner",
  "type": "object"
}
