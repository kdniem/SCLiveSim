# Copy to .env and adjust. .env is gitignored.

# PostgreSQL (used by docker compose and by the engine/API)
POSTGRES_USER=livesim
POSTGRES_PASSWORD=livesim
POSTGRES_DB=livesim
POSTGRES_PORT=5432

# Connection string for processes running on the host (tests, local dev)
DATABASE_URL=postgresql://livesim:livesim@localhost:5432/livesim
