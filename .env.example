# Copy to .env and adjust. .env is gitignored.

# PostgreSQL (used by docker compose and by the engine/API)
POSTGRES_USER=livesim
POSTGRES_PASSWORD=livesim
POSTGRES_DB=livesim
POSTGRES_PORT=5432

# Connection string for processes running on the host (tests, local dev)
DATABASE_URL=postgresql://livesim:livesim@localhost:5432/livesim

# Host ports
API_PORT=8000
CONTROL_TOWER_PORT=8080

# Engine: start these scenarios (comma-separated, e.g. wholesale,dataco)
# automatically when the database has no run yet
# (set LIVESIM_AUTOSTART= to disable)
LIVESIM_AUTOSTART=wholesale
LIVESIM_AUTOSTART_TIME_FACTOR=1440
LIVESIM_AUTOSTART_SEED=42
# Download the DataCo dataset from Mendeley Data if data/raw has no copy
DATACO_AUTO_DOWNLOAD=true
